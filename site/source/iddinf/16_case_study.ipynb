      "  warnings.warn(\n"
     ]
    }
   ],
   "source": [
    "initial_position = model.sample(seir=seir_sim, beta=0.3, alpha=80, sigma=1/4.0, gamma=1/4.41, epsilon=3.8e-4, h0=0.03, seed=jax.random.key(2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "0soCE5HmrM2Z"
   },
   "source": [
    "compile the MCMC sampling function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "metadata": {
    "id": "hcpJKT5ujJpJ",
    "tags": []
   },
   "outputs": [],
   "source": [
    "def sample_chain(num_samples, seed):\n",
    "    return mcmc(\n",
    "        num_samples = num_samples,\n",
    "        sampling_algorithm=kernel,\n",
    "        target_density_fn=model.log_prob,\n",
    "        initial_position=initial_position,\n",
    "        seed=seed\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "HhcrQKhprWGN"
