     "height": 448
    },
    "id": "o4nZq_5-pSdt",
    "outputId": "cd0ba070-52c2-4fd3-90c7-3c847282928e"
   },
   "outputs": [],
   "source": [
    "# The resulting tensor is of shape [K, N, L], so we\n",
    "# plot the SE (L=0) traceplot for the 101st individual (N=101)\n",
    "plt.plot(se_time_samples[:,100,0])"
   ]
  },
