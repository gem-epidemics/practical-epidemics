t has the same pytree \u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m    416\u001b[39m       \u001b[33m\"\u001b[39m\u001b[33mstructure as the carry input.\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    417\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m \u001b[38;5;28mall\u001b[39m(_map(core.typematch, in_avals, out_avals)):\n\u001b[32m    418\u001b[39m   diffs = [\u001b[33mf\u001b[39m\u001b[33m'\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mcomponent(path)\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m has type \u001b[39m\u001b[38;5;132;01m{\u001b[39;00min_aval.str_short()\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m'\u001b[39m\n\u001b[32m    419\u001b[39m            \u001b[33m'\u001b[39m\u001b[33m but the corresponding output carry component has type \u001b[39m\u001b[33m'\u001b[39m\n\u001b[32m    420\u001b[39m            \u001b[33mf\u001b[39m\u001b[33m'\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mout_aval.str_short()\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m'\u001b[39m\n\u001b[32m    421\u001b[39m            \u001b[33mf\u001b[39m\u001b[33m'\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mcore.aval_mismatch_extra(in_aval,\u001b[38;5;250m \u001b[39mout_aval)\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m'\u001b[39m\n\u001b[32m    422\u001b[39m            \u001b[38;5;28;01mfor\u001b[39;00m path, in_aval, out_aval \u001b[38;5;129;01min\u001b[39;00m \u001b[38;5;28mzip\u001b[39m(paths, in_avals, out_avals)\n\u001b[32m    423\u001b[39m            \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m core.typematch(in_aval, out_aval)]\n",
